{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor event",
  "description": "Payload of the `doctor` command (ARCHITECTURE 4.2).",
  "type": "object",
  "required": ["type", "checks"],
  "properties": {
    "type": { "const": "doctor" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ok", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "detail": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
