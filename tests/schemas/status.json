{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "status event",
  "description": "Payload of the `status` command (ARCHITECTURE 4.2).",
  "type": "object",
  "required": [
    "type", "ready", "missing", "authenticated", "venv_ready", "marketplace",
    "account", "catalog_age_s", "config_dir", "data_dir", "runtime_dir", "books_dir",
    "books_dir_problem", "old_books", "books_location_recorded", "mpris_script",
    "downloads_paused_until"
  ],
  "properties": {
    "type": { "const": "status" },
    "ready": { "type": "boolean" },
    "missing": { "type": "array", "items": { "type": "string" } },
    "authenticated": { "type": "boolean" },
    "venv_ready": { "type": "boolean" },
    "venv_state": { "enum": ["current_ready", "usable_old", "broken", "missing"] },
    "marketplace": { "type": ["string", "null"] },
    "account": { "type": ["string", "null"] },
    "catalog_age_s": { "type": ["integer", "null"], "minimum": 0 },
    "config_dir": { "type": "string", "pattern": "^/" },
    "data_dir": { "type": "string", "pattern": "^/" },
    "runtime_dir": { "type": "string", "pattern": "^/" },
    "books_dir": { "type": "string", "pattern": "^/" },
    "books_dir_problem": { "type": ["string", "null"] },
    "old_books": {
      "type": ["object", "null"],
      "required": ["dir", "count"],
      "properties": {
        "dir": { "type": "string", "pattern": "^/" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "books_location_recorded": { "type": "boolean" },
    "mpris_script": { "type": ["string", "null"], "pattern": "^/" },
    "downloads_paused_until": { "type": ["string", "null"], "minLength": 1 }
  },
  "additionalProperties": false
}
