{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error event",
  "description": "Final event of a failed backend run (ARCHITECTURE 4.2).",
  "type": "object",
  "required": ["type", "code", "message"],
  "properties": {
    "type": { "const": "error" },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "hint": { "type": "string" }
  },
  "additionalProperties": false
}
