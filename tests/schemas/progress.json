{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "progress event",
  "description": "Intermediate progress event (ARCHITECTURE 4.2). `sync` reports stage `library` with `n`/`of`; `get` reports stage `download` or `convert` with `bytes`/`total`; `setup` streams its own stages. The stage is left open because ARCHITECTURE does not enumerate every setup stage.",
  "type": "object",
  "required": ["type", "stage"],
  "properties": {
    "type": { "const": "progress" },
    "stage": { "type": "string", "minLength": 1 },
    "n": { "type": "integer", "minimum": 0 },
    "of": { "type": "integer", "minimum": 0 },
    "bytes": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "stage": { "const": "library" } },
        "required": ["stage"]
      },
      "then": { "required": ["n", "of"] }
    },
    {
      "if": {
        "properties": { "stage": { "enum": ["download", "convert"] } },
        "required": ["stage"]
      },
      "then": { "required": ["bytes", "total"] }
    }
  ]
}
