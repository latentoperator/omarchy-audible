#!/usr/bin/env python3
"""Omarchy Audible backend launcher.

Standard library only, so it runs on a fresh machine before the plugin
virtualenv exists. It inspects the subcommand just far enough to decide where to
run it, then starts the backend package in ``backend/``:

* ``status``, ``doctor`` and ``setup`` must work with no dependency installed,
  so they run from the repository source with the system Python.
* Fake mode (``--fake`` or ``OMARCHY_AUDIBLE_FAKE=1``) also runs from the
  repository source: it never touches the network or the account, so it needs
  no third-party dependency either.
* Any other command needs the pinned ``audible`` dependency and runs under the
  plugin virtualenv interpreter.

The launcher never imports the backend package or any third-party module; it
re-execs itself as ``python -m omarchy_audible`` so the backend replaces this
process (same PID). Only NDJSON may reach stdout: the backend writes the
protocol and the launcher writes at most one ``error`` event (``no_venv``) when
there is nowhere to run a command.
"""

from __future__ import annotations

import json
import os
import sys
import sysconfig
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BACKEND_DIR = REPO_ROOT / "backend"
MODULE = "omarchy_audible"

# Names a completed virtualenv, written by `setup` last (backend/omarchy_audible/
# bootstrap.py). A venv without it is a run that was killed midway; the launcher
# must not dispatch into it. A test keeps this in step with the backend constant.
VENV_MARKER = "omarchy-audible.setup.json"

# Commands the launcher can run from the repository source with no dependency.
LAUNCHER_COMMANDS = frozenset({"status", "doctor", "setup"})

# Every command the backend knows. Kept here (the launcher must not import the
# backend package) and checked against the backend registry by a test so the two
# cannot drift.
KNOWN_COMMANDS = frozenset(
    {
        "status",
        "doctor",
        "setup",
        "sync",
        "get",
        "remove",
        "local",
        "play-info",
        "login-start",
        "login-finish",
        "login-import-cli",
        "logout",
        "cancel",
        "position-get",
        "position-push",
        "books-location-ack",
    }
)

_TRUTHY = frozenset({"1", "true", "yes", "on"})


def _wants_fake(argv: list[str], env: dict[str, str]) -> bool:
    if "--fake" in argv:
        return True
    return str(env.get("OMARCHY_AUDIBLE_FAKE", "")).strip().lower() in _TRUTHY


def _command(argv: list[str]) -> str | None:
    for token in argv:
        if not token.startswith("-"):
            return token
    return None


def _venv_python(env: dict[str, str]) -> Path:
    data_home = env.get("XDG_DATA_HOME")
    if data_home:
        base = Path(data_home)
    else:
        home = env.get("HOME") or str(Path.home())
        base = Path(home) / ".local" / "share"
    return base / "omarchy-audible" / "venv" / "bin" / "python"


def _venv_ready(venv_python: Path) -> bool:
    """Validate saved offline health evidence without importing the backend.

    Kept equivalent to bootstrap.venv_ready by parametrized dispatch tests.
    Old pins remain usable; compatibility and health evidence may not be old.
    """
    root = venv_python.parent.parent
    try:
        marker = json.loads((root / VENV_MARKER).read_text(encoding="utf-8"))
        # Preserve 0.1.5 dispatch until status records the one-time probe.
        # Only the complete old format qualifies, never a damaged new marker.
        if (
            isinstance(marker, dict)
            and set(marker)
            == {"schema", "requirements", "requirements_file", "created_at"}
            and type(marker.get("schema")) is int
            and marker["schema"] == 1
            and isinstance(marker.get("requirements"), str)
            and len(marker["requirements"]) == 64
            and all(c in "0123456789abcdef" for c in marker["requirements"])
            and marker.get("requirements_file") == "requirements.lock"
            and isinstance(marker.get("created_at"), str)
            and marker["created_at"]
        ):
            return venv_python.is_file() and os.access(venv_python, os.X_OK)
        identity = [
            sys.implementation.name,
            sys.implementation.cache_tag,
            sys.version_info.major,
            sys.version_info.minor,
            sysconfig.get_config_var("SOABI"),
        ]
        if (
            not isinstance(marker, dict)
            or marker.get("schema") != 2
            or marker.get("python") != identity
            or not venv_python.is_file()
            or not os.access(venv_python, os.X_OK)
        ):
            return False
        versions = marker.get("versions")
        files = marker.get("files")
        if (
            not isinstance(versions, dict)
            or not all(
                isinstance(versions.get(name), str) and versions[name]
                for name in ("audible", "audible-cli")
            )
            or not isinstance(files, dict)
            or not {"bin/python", "pyvenv.cfg"}.issubset(files)
        ):
            return False
        for name, saved in files.items():
            if (
                not isinstance(name, str)
                or Path(name).is_absolute()
                or ".." in Path(name).parts
            ):
                return False
            stat = (root / name).stat()
            if [
                stat.st_ino,
                stat.st_size,
                stat.st_mtime_ns,
                stat.st_ctime_ns,
                stat.st_mode,
            ] != saved:
                return False
        return True
    except (OSError, ValueError):
        return False


def _emit_error(code: str, message: str, hint: str | None = None) -> None:
    event: dict[str, str] = {"type": "error", "code": code, "message": message}
    if hint:
        event["hint"] = hint
    sys.stdout.write(json.dumps(event, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _pycache_prefix(env: dict[str, str]) -> str:
    # A relative XDG_CACHE_HOME is invalid by the XDG spec; ignore it.
    cache_home = env.get("XDG_CACHE_HOME") or ""
    if os.path.isabs(cache_home):
        base = Path(cache_home)
    else:
        base = Path(env.get("HOME") or str(Path.home())) / ".cache"
    return str(base / "omarchy-audible" / "pycache")


def _run_backend(argv: list[str], env: dict[str, str], fake: bool, python: str) -> int:
    child_env = dict(env)
    # Python's bytecode cache goes under ~/.cache, never next to the source.
    # The plugin folder is watched by the shell (inotifywait on
    # ~/.config/omarchy/plugins), and every .pyc written there makes it reload
    # the plugin; on Quickshell 0.3.1 that reload can crash the shell.
    # An inherited prefix is kept only if absolute: an empty one means "next to
    # the source" and a relative one depends on the spawner's cwd.
    if not os.path.isabs(child_env.get("PYTHONPYCACHEPREFIX") or ""):
        child_env["PYTHONPYCACHEPREFIX"] = _pycache_prefix(env)
    path_parts = [str(BACKEND_DIR)]
    existing = child_env.get("PYTHONPATH")
    if existing:
        path_parts.append(existing)
    child_env["PYTHONPATH"] = os.pathsep.join(path_parts)
    if fake:
        child_env["OMARCHY_AUDIBLE_FAKE"] = "1"
    child_argv = [token for token in argv if token != "--fake"]
    try:
        # Replace this process with the backend (ARCHITECTURE 4.1). The job then
        # runs under the PID the UI spawned, so killing that PID stops the job
        # and releases job.lock (ARCHITECTURE 4.8).
        os.execve(python, [python, "-m", MODULE, *child_argv], child_env)
    except OSError as exc:
        _emit_error("internal", f"could not start the backend: {exc}")
        return 1
    return 1  # unreachable on success: execve replaces the process image


def main(argv: list[str]) -> int:
    env = dict(os.environ)
    fake = _wants_fake(argv, env)
    command = _command(argv)
    python = sys.executable or "python3"

    # Unknown commands are forwarded so the backend can report
    # error(code=unknown_command) on stdout.
    if (
        fake
        or command is None
        or command in LAUNCHER_COMMANDS
        or command not in KNOWN_COMMANDS
    ):
        return _run_backend(argv, env, fake, python)

    venv_python = _venv_python(env)
    if not _venv_ready(venv_python):
        _emit_error(
            "no_venv",
            "the plugin virtualenv is missing, incompatible or needs repair",
            hint="run: omarchy-audible setup",
        )
        return 1
    return _run_backend(argv, env, fake, str(venv_python))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
