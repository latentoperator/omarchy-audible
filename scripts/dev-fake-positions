#!/usr/bin/env python3
"""Dev stand-in for the fake backend's position store (development only).

The backend's fake mode has no remote position: reads are always empty and a
push does nothing, so a "newer remote" or an offline account cannot be
simulated. This wrapper handles `position-get` and `position-push` against a
JSON file and passes every other command to the real launcher, in fake mode.

Enable (tmpfs, so a reboot undoes it; only honoured while the dev-fake flag is set):
    echo "$PWD/scripts/dev-fake-positions" > $XDG_RUNTIME_DIR/omarchy-audible-dev-launcher
Go offline:      touch $XDG_RUNTIME_DIR/omarchy-audible-fake/dev-offline
Set the remote:  scripts/dev-fake-positions set <asin> <ms> <iso-8601>
Show it:         scripts/dev-fake-positions show
"""

import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LAUNCHER = ROOT / "bin" / "omarchy-audible"


def runtime_dir() -> Path:
    return Path(os.environ["XDG_RUNTIME_DIR"]) / "omarchy-audible-fake"


def data_dir() -> Path:
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "omarchy-audible-fake"


def store_path() -> Path:
    return runtime_dir() / "dev-positions.json"


def load() -> dict:
    try:
        return json.loads(store_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save(items: dict) -> None:
    runtime_dir().mkdir(parents=True, exist_ok=True)
    store_path().write_text(json.dumps(items), encoding="utf-8")


def emit(**event) -> None:
    print(json.dumps(event), flush=True)


def parse(value):
    if not isinstance(value, str) or not value:
        return None
    text = value.replace("Z", "+00:00")
    try:
        parsed = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=datetime.timezone.utc)
    return parsed


def offline() -> bool:
    if (runtime_dir() / "dev-offline").exists():
        emit(type="error", code="network", message="dev: offline", hint="remove dev-offline")
        return True
    return False


def position_get(asins: list) -> int:
    if offline():
        return 1
    items = load()
    out = {a: items.get(a, {"ms": 0, "updated_at": None}) for a in asins}
    cache = data_dir() / "remote.json"
    try:
        cached = json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cached = {}
    cached.update(out)
    cache.write_text(json.dumps(cached), encoding="utf-8")
    emit(type="positions", items=out)
    emit(type="done")
    return 0


def position_push(args: list) -> int:
    if len(args) < 2:
        emit(type="error", code="invalid_args", message="position-push needs <asin> <ms>")
        return 2
    if offline():
        return 1
    asin, ms = args[0], int(args[1])
    at = args[args.index("--at") + 1] if "--at" in args else None
    items = load()
    remote = parse(items.get(asin, {}).get("updated_at"))
    local = parse(at) or datetime.datetime.now(datetime.timezone.utc)
    if remote is not None and remote > local:
        emit(type="error", code="stale", message="the remote position is newer", hint="resume instead")
        return 1
    stamp = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
    items[asin] = {"ms": ms, "updated_at": stamp}
    save(items)
    emit(type="done")
    return 0


def main(argv: list) -> int:
    if argv and argv[0] == "set" and len(argv) == 4:
        items = load()
        items[argv[1]] = {"ms": int(argv[2]), "updated_at": argv[3]}
        save(items)
        return 0
    if argv and argv[0] == "show":
        print(json.dumps(load(), indent=1))
        return 0
    if argv and argv[0] == "position-get":
        return position_get(argv[1:])
    if argv and argv[0] == "position-push":
        return position_push(argv[1:])
    os.environ["OMARCHY_AUDIBLE_FAKE"] = "1"
    return subprocess.call([str(LAUNCHER), *argv])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
